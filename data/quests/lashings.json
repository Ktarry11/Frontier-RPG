    {
      "quest_id": "lsh_the_bosun",
      "title": "Everybody On Deck",
      "giver_npc_id": "stw_harbourmaster",
      "zone": "the_lashings",
      "level_min": 46,
      "level_max": 46,
      "description": "A bosun holds the first gangway, and there is no way round a gangway.",
      "objectives": [
        {
          "type": "kill_boss",
          "target": "Bosun Grell Tarpot",
          "count": 1,
          "zone": "the_lashings"
        },
        {
          "type": "kill",
          "target": "Southsea Swabbie",
          "count": 6,
          "zone": "the_lashings"
        }
      ],
      "reward_exp": 4316,
      "reward_gold": 17160,
      "accept_text": "Here is what I have worked out about that cove and it is the only useful thing anybody has said about it in twenty years.\n\nThey are hulls lashed together. One plank between each. There is no going round, for you OR for them - which means you can take it apart one deck at a time and they cannot flank you, and it also means every single plank has somebody standing on it.\n\nThe first one is Grell Tarpot. You will hear him before you see him.",
      "turn_in_text": "The whole cove heard that. Good.\n\nThey cannot reinforce past a man standing on a three-foot plank any more than you can get past one. Twenty years they have been safe behind that and today it is the thing holding them still.",
      "next_quest_id": "lsh_the_sailmaker",
