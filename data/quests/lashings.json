    {
      "quest_id": "lsh_the_last_column",
      "title": "Which Side It Came From",
      "giver_npc_id": "stw_tally_clerk",
      "zone": "steamwheedle_port",
      "level_min": 48,
      "level_max": 48,
      "description": "The clerk who keeps the last two columns has one more to add.",
      "objectives": [
