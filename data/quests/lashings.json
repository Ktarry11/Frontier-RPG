    {
      "quest_id": "lsh_my_own_powder",
      "title": "That Is My Powder",
      "giver_npc_id": "stw_engineer",
      "zone": "steamwheedle_port",
      "level_min": 45,
      "level_max": 45,
      "description": "The engineer's powder is in the cove and he is embarrassed about how it got there.",
      "objectives": [
        {
          "type": "kill",
          "target": "Southsea Powdermonkey",
          "count": 8,
          "zone": "the_lashings"
        },
        {
          "type": "fetch",
          "target": "lsh_short_keg",
          "count": 5
        }
      ],
      "reward_exp": 3240,
      "reward_gold": 12900,
      "accept_text": "I build things that mostly work and I am honest about the mostly, so I am going to be honest about this: I sold them the powder.\n\nNot knowingly. A freight agent I will not name, a standing order, four years of it, and I never once asked where it went because the money was good and I had a workshop to replace.\n\nGo and get me a keg back. I want to see my own cooperage mark with a scrape through it.",
      "turn_in_text": "There it is. Scraped, not sanded - they were in a hurry and they did not care.\n\nForty-one of those went up the coast. I have had three years of telling people my whole workshop is still in Gadgetzan and feeling sorry for myself, and in the same three years I armed a pirate fleet by not asking a question.",
      "next_quest_id": null,
