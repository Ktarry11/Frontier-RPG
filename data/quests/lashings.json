    {
      "quest_id": "lsh_recognising_my_own_stock",
      "title": "I Have Started Recognising It",
      "giver_npc_id": "stw_salvage_broker",
      "zone": "steamwheedle_port",
      "level_min": 44,
      "level_max": 45,
      "description": "The salvage broker keeps being offered things she sold last month.",
      "objectives": [
        {
          "type": "kill",
          "target": "Southsea Rigger",
          "count": 8,
          "zone": "the_lashings"
        },
        {
          "type": "fetch",
          "target": "lsh_prize_tag",
          "count": 5
        }
      ],
      "reward_exp": 3240,
      "reward_gold": 12900,
      "accept_text": "I buy what came off something and I sell it onto something else and I have never once pretended otherwise.\n\nWhat I will not do is buy my own stock back. Twice this season somebody has put a crate on my counter that I SOLD, out of this shop, six weeks before.\n\nGet me the tags off them. Hesper inks every crate that leaves this port and they have been re-inking over the top, and badly.",
      "turn_in_text": "Her hand underneath and theirs on top. Every one.\n\nThat is not a pirate crew taking a prize at sea. That is somebody going through a manifest. They know what is on our ships before the ships leave.",
      "next_quest_id": null,
