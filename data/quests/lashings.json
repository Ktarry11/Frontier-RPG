    {
      "quest_id": "lsh_the_boarding_nets",
      "title": "Weighted at the Hem",
      "giver_npc_id": "stw_shipwright",
      "zone": "steamwheedle_port",
      "level_min": 45,
      "level_max": 45,
      "description": "The nets are not for fish.",
      "objectives": [
        {
          "type": "kill",
          "target": "Southsea Netcaster",
          "count": 9,
          "zone": "the_lashings"
        },
        {
          "type": "fetch",
          "target": "lsh_cut_net",
          "count": 5
        }
      ],
      "reward_exp": 3240,
      "reward_gold": 12900,
      "accept_text": "A fishing net is weighted evenly. A boarding net is weighted at the HEM so it drops flat over a deck and nobody under it can stand up.\n\nI have mended both for thirty years and I can tell them apart in the dark. Bring me what they are using and I will tell the harbourmaster exactly what her crews are walking into.",
      "turn_in_text": "Hem-weighted, every one, and the mesh is tight enough that a cutlass will not go through it.\n\nThey are not sinking anybody. They have never wanted to sink anybody. They want the deck and the crew standing still on it, and that is a much more frightening sentence than the other one.",
      "next_quest_id": null,
