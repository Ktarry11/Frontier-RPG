{
  "quests": [
    {
      "quest_id": "lsh_four_berths",
      "title": "You Can See the Masts From the Yard",
      "giver_npc_id": "stw_harbourmaster",
      "zone": "steamwheedle_port",
      "level_min": 44,
      "level_max": 44,
      "description": "The harbourmaster has lost three sailings this season and is done being patient.",
      "objectives": [
        {
          "type": "dialogue",
          "topics": [
            "lsh_the_cove",
            "lsh_the_arithmetic"
          ]
        },
        {
          "type": "explore",
          "target": "the_lashings",
          "target_x": 68,
          "target_y": 106,
          "radius": 8
        }
      ],
      "reward_exp": 3160,
      "reward_gold": 12600,
      "accept_text": "Four berths, and I have been turning ships away since the second winter. Three years ago that was an inconvenience. Now it is the whole town's throat.\n\nAnd four miles up that coast there are nine hulls lashed together with about a hundred people on them taking one sailing in six.\n\nThis port has spent twenty years deciding that is somebody else's problem. Go and stand on the first deck and come back and tell me if it still is.",
      "turn_in_text": "They have not moved in twenty years. Not one of those hulls has moved.\n\nThat is the part I cannot get the yard to understand. A fleet that sails is weather. A fleet that sits there is a NEIGHBOUR, and you do not get to ignore a neighbour for twenty years and then be surprised.",
      "next_quest_id": "lsh_recognising_my_own_stock",
