    {
      "quest_id": "lsh_the_powder_master",
      "title": "Forty-One Barrels",
      "giver_npc_id": "stw_engineer",
      "zone": "the_lashings",
      "level_min": 47,
      "level_max": 47,
      "description": "His powder, and the man who has been counting it.",
      "objectives": [
        {
          "type": "kill_boss",
          "target": "Powder-Master Juss Wick",
          "count": 1,
          "zone": "the_lashings"
        },
        {
          "type": "fetch",
          "target": "lsh_short_keg",
          "count": 4
        }
      ],
      "reward_exp": 4420,
      "reward_gold": 17550,
      "accept_text": "Juss Wick keeps the powder hulk, which is the third hull up, and he has been keeping it for longer than I have been selling to him.\n\nHe knows exactly where every barrel is. I know that because I know how much I sent and the harbourmaster knows how much has gone off in the last four years, and the difference has not been wasted by anybody.\n\nI would like my mark back and I would like him to not have it.",
      "turn_in_text": "Forty-one. He had it written on a board.\n\nI am going to pay for the cooperage to restamp everything in my shop with a mark that cannot be scraped. It will cost me more than the powder did. I am going to do it anyway.",
