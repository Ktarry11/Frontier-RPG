    {
      "quest_id": "gsq_horde_ground",
      "title": "Horde Ground",
      "giver_npc_id": "gs_orc_envoy",
      "zone": "great_settlement",
      "level_min": 45,
      "level_max": 46,
      "description": "Envoy Grukk has waited a year for Zan'kaji's answer to Orgrimmar. The High Chieftain has finally given it, and Grukk would rather it went to Thrall with someone who's earned the tribes' trust.",
      "objectives": [
        {
          "type": "deliver",
          "target": "gs_q_zankajis_answer",
          "count": 1,
          "label": "Carry Zan'kaji's answer to Thrall in Orgrimmar"
        }
      ],
      "accept_text": "A year I've sat on this terrace waiting, and he gives me his answer the week you turn up. I'd carry it myself, but I've been told to wait for the next one. Take it to Thrall in Grommash Hold, and take the bats from the Roost, they're faster than the boats.",
      "turn_in_text": "The tree isn't Horde ground, and it isn't Alliance ground either. It's theirs, and they'll stand with us when we stand with them.\n\nThat's a better answer than most I get. Tell Zan'kaji that Orgrimmar heard him, and that the Horde remembers who held the line when the world broke.",
      "next_quest_id": null,
      "turn_in_npc_id": "org_thrall",
      "requires_quests": [
        "gsq_the_war_below"
      ],
      "grant_items": {
        "on_accept": [
          {
            "item_id": "gs_q_zankajis_answer",
            "name": "Zan'kaji's Answer",
            "description": "A sealed letter on bark, painted with the Highbough's teal and red, for the Warchief.",
            "count": 1
          }
        ]
      },
      "reward_exp": 3320,
      "reward_gold": 13200,
