    {
      "quest_id": "gsq_the_war_below",
      "title": "The War Below",
      "giver_npc_id": "gs_zankaji",
      "zone": "great_settlement",
      "level_min": 45,
      "level_max": 45,
      "description": "High Chieftain Zan'kaji wants the Bloodscalp who climb onto the Great Bough broken, and their war leaders with them, before he trusts you with the tribes' business.",
      "objectives": [
        {
          "type": "kill",
          "target": "Bloodscalp Reaver",
          "count": 6,
          "zone": "lower_boughs"
        },
        {
          "type": "kill",
          "target": "Bloodscalp Bough-Shaman",
          "count": 4,
          "zone": "lower_boughs"
        }
      ],
      "accept_text": "The Bloodscalp come up the ropes at the Climbers' Cut, down on the Lower Boughs, and their Bloodscalp Reavers lead every climb. Their Bloodscalp Bough-Shamans call the storm down on anyone who's in their way. Go down and break them, and come back and tell me how it went.",
      "turn_in_text": "That's the kind of story I like, one with the ending already done.\n\nThe tribes will hear about this. From now on, when the Settlement needs something done, my people will come to you first.",
      "next_quest_id": "gsq_horde_ground",
      "requires_quests": [
        "gsq_an_audience"
      ],
      "reward_exp": 3240,
      "reward_gold": 12900,
