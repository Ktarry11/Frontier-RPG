    {
      "quest_id": "gsq_the_wall_of_fallen_things",
      "title": "The Wall of Fallen Things",
      "giver_npc_id": "gs_scholar",
      "zone": "great_settlement",
      "level_min": 45,
      "level_max": 46,
      "description": "Scholar Yenvaa keeps the wall in the market where the scholars show what's fallen from the clouds. The spiders below have been wrapping crystal chips in silk, and she wants them for the wall.",
      "objectives": [
