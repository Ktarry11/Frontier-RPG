    {
      "quest_id": "gsq_an_audience",
      "title": "An Audience",
      "giver_npc_id": "gs_liftkeeper",
      "zone": "great_settlement",
      "level_min": 45,
      "level_max": 45,
      "description": "Liftwarden Ozenna keeps the top of the Great Lift. Anyone the elders below send up is meant to present themselves to the High Chieftain, and she's written you a pass for the guards on the Rise.",
      "objectives": [
        {
          "type": "deliver",
          "target": "gs_q_lift_pass",
          "count": 1,
          "label": "Present Ozenna's pass to High Chieftain Zan'kaji on the Chieftain's Rise"
        }
      ],
      "accept_text": "Tal'vani sent word you were coming up. Everybody she sends goes to the High Chieftain first, so take this pass and go along the ledge to the Heart Palace. You'll know it, it's the one wrapped round the trunk.",
      "turn_in_text": "Ozenna's pass, and Tal'vani's word before it. The tribes have been talking about you since Mossroof.\n\nMy name's Zan'kaji, and I hold this tree for the tribes who climbed it, and I don't hand out trust for a good story. Show me what you can do and we'll talk about what the tribes can do for you.",
      "next_quest_id": "gsq_the_war_below",
      "turn_in_npc_id": "gs_zankaji",
      "grant_items": {
        "on_accept": [
          {
            "item_id": "gs_q_lift_pass",
            "name": "Liftwarden's Pass",
            "description": "A strip of painted bark with Ozenna's mark on it, for the guards on the Chieftain's Rise.",
            "count": 1
          }
        ]
      },
