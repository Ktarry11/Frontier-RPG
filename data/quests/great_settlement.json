    {
      "quest_id": "gsq_the_record",
      "title": "The Record",
      "giver_npc_id": "gs_scholar",
      "zone": "great_settlement",
      "level_min": 46,
      "level_max": 46,
      "description": "Yenvaa wants the crystal from the web-hall entered into the scholars' record. Archivist Tel'zan keeps it in the scholars' hall at the Roost.",
