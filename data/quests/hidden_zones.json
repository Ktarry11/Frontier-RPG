    {
      "quest_id": "hz_saltgrave_coins",
      "title": "Grave-Gold",
      "giver_npc_id": "hz_saltgrave_maud",
      "zone": "the_saltgrave",
      "level_min": 38,
      "level_max": 40,
      "elite": false,
      "description": "I'm Maud. I comb this sand for a living, and the living's been thin since the barrows opened.\n\nThe dead out here were buried with their gold, and now they walk about with it in their pockets. Coins with a king on them that nobody remembers. I've a buyer in the highlands who'll pay for every one, and I'm too old to argue with a wight over it.\n\nThey come up out of the west barrow and the east one. Bring me eight coins and I'll make it worth the trip.",
      "objectives": [
        {
          "type": "fetch",
          "target": "barrow_coin",
          "count": 8
        }
      ],
      "reward_exp": 4151,
      "reward_gold": 15884,
      "accept_text": "The west barrow and the east one. Mind your feet on the way over, the shallows shift.",
      "turn_in_text": "Eight. Look at that king. Nobody's spent one of these in a thousand years, and now I'm going to.\n\nYou've earned your cut.",
