        {
          "type": "kill",
          "target": "Barrow Lantern",
          "count": 6
        },
        {
          "type": "kill",
          "target": "Brine-Wight",
          "count": 6
        }
      ],
      "reward_exp": 4260,
      "reward_gold": 16302,
      "accept_text": "The barrows, west and east. Don't follow a light anywhere it wants you to go.",
      "turn_in_text": "It's darker out there tonight. Good dark. The kind you can sleep in.",
