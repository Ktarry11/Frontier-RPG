    {
      "quest_id": "hz_glass_shards",
      "title": "Glass Teeth",
      "giver_npc_id": "hz_glasswaste_durek",
      "zone": "the_glasswaste",
      "level_min": 15,
      "level_max": 17,
      "elite": false,
      "description": "The basilisks here grow glass on their backs. They lie in the hot sand and it fuses to them, a little more every year, till they're walking about wearing a fortune.\n\nI make blades from it. Best edge you'll ever see, and it never rusts. But I've got one good leg left and I'm keeping it.\n\nThe shard fields, west of the mouth. Eight shards.",
