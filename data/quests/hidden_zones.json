    {
      "quest_id": "hz_saltgrave_lanterns",
      "title": "Lights on the Barrows",
      "giver_npc_id": "hz_saltgrave_maud",
      "zone": "the_saltgrave",
      "level_min": 39,
      "level_max": 41,
      "elite": false,
      "description": "You've seen the lights out on the barrows at night. Corpse-lights, my mother called them. They're not lights. They're the dead that couldn't find their bodies, and they lead the living ones out into the water.\n\nI lost a boat to them last winter. I'd like to stop losing things.\n\nPut out six of the lights, and six of the wights they keep lit for.",
