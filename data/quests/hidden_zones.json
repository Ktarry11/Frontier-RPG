    {
      "quest_id": "hz_saltgrave_king",
      "title": "The Brine King (Elite)",
      "giver_npc_id": "hz_saltgrave_maud",
      "zone": "the_saltgrave",
      "level_min": 40,
      "level_max": 42,
      "elite": true,
      "description": "There's a fourth barrow, out on its own to the north. The King's. The others are his thanes, and they don't rest because he doesn't.\n\nHe walks the top of his barrow at low tide with his crown on, and he doesn't like visitors. I won't lie to you: I wouldn't go alone. I wouldn't go at all. But if anyone's going to put him back in the ground, it'll be somebody who brought friends.\n\nHis thanes stand round him. Cut through five and you'll find him.",
      "objectives": [
        {
          "type": "kill",
          "target": "The Brine King",
          "count": 1
        },
        {
          "type": "kill",
          "target": "Drowned Barrow-Thane",
          "count": 5
        }
      ],
      "reward_exp": 7600,
      "reward_gold": 30400,
      "accept_text": "North, out past the middle bar. Bring friends. I mean it.",
      "turn_in_text": "You did it. The water's gone still out there, first time since I came.\n\nThat's the best thing I own. Take it.",
